# Server-only. Copiar a .env.local; nunca subir secretos a Git.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Supabase: runtime (pooler) y migraciones (session pooler/direct).
DATABASE_URL=
DIRECT_URL=
# 32 bytes aleatorios en base64. Conservar entre despliegues.
TOKEN_ENCRYPTION_KEY=
# Correos completos autorizados, separados por coma. Vacío bloquea el acceso.
AUTH_ALLOWED_EMAILS=
# Reservado para fases futuras.
STORAGE_BUCKET=
# Opcional: directorio privado del ejemplo S40 (PPTX y seis PNG).
# Predeterminado: .private/reports/s40-2026 dentro del proyecto.
REPORT_EXAMPLE_DIR=
